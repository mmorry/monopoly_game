---
interface Props {
	href: string;
	label: string;
	description: string;
	variant: 'primary' | 'secondary';
}

const { href, label, description, variant } = Astro.props;

const variantClasses = {
	primary:
		'border-emerald-800 bg-emerald-700 text-white shadow-[0_8px_0_#14532d] hover:bg-emerald-600 active:translate-y-1 active:shadow-[0_4px_0_#14532d]',
	secondary:
		'border-amber-950/20 bg-amber-100 text-amber-950 shadow-[0_8px_0_#92400e] hover:bg-amber-200 active:translate-y-1 active:shadow-[0_4px_0_#92400e]'
}[variant];
---

<a
	href={href}
	class={`group flex w-full items-center gap-4 rounded-2xl border-2 p-4 text-left transition duration-150 ease-out focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-emerald-700 ${variantClasses}`}
>
	<span class="grid size-12 shrink-0 place-items-center rounded-xl bg-white/15 ring-1 ring-inset ring-current/15">
		<slot name="icon" />
	</span>
	<span class="min-w-0">
		<span class="block text-lg font-bold tracking-tight">{label}</span>
		<span class="mt-0.5 block text-sm leading-5 opacity-80">{description}</span>
	</span>
	<svg
		class="ml-auto size-5 shrink-0 transition-transform duration-150 group-hover:translate-x-1 group-active:translate-x-0"
		viewBox="0 0 20 20"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		aria-hidden="true"
	>
		<path d="m7 4 6 6-6 6" />
	</svg>
</a>

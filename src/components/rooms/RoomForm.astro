---
interface Props { mode: 'create' | 'join' }
const { mode } = Astro.props;
const isCreate = mode === 'create';
---
<div class="w-full">
  <form class="rounded-[2rem] border border-amber-950/10 bg-white p-6 shadow-xl sm:p-8"
    data-room-form data-mode={mode} aria-labelledby="room-form-heading">
    <p class="text-xs font-bold uppercase tracking-widest text-red-700">Monopoly Perú</p>
    <h1 id="room-form-heading" class="mt-2 text-3xl font-black text-emerald-950">
      {isCreate ? 'Crear una sala' : 'Unirse a una partida'}
    </h1>
    <p class="mt-3 text-sm leading-6 text-stone-600">
      {isCreate ? 'Configura una mesa privada. Tus amigos entrarán con un código, sin crear cuentas.' :
        'Escribe el código compartido por el anfitrión y el alias con el que jugarás.'}
    </p>
    <div class="mt-7 grid gap-5">
      {isCreate ? (
        <>
          <label class="grid gap-2 text-sm font-semibold text-emerald-950">
            Nombre de la sala (opcional)
            <input class="game-input" name="roomName" maxlength="48" placeholder="Viernes de Monopoly" />
          </label>
          <div class="grid grid-cols-2 gap-4">
            <label class="grid gap-2 text-sm font-semibold text-emerald-950">
              Jugadores
              <select class="game-input" name="maxPlayers">
                {[2,3,4,5,6].map((n) => <option value={n} selected={n===6}>{n}</option>)}
              </select>
            </label>
            <label class="grid gap-2 text-sm font-semibold text-emerald-950">
              Dados
              <select class="game-input" name="diceMode">
                <option value="virtual">Virtuales</option>
                <option value="physical">Físicos</option>
              </select>
            </label>
          </div>
        </>
      ) : (
        <label class="grid gap-2 text-sm font-semibold text-emerald-950">
          Código de la sala
          <input class="game-input uppercase" name="roomCode" required maxlength="16"
            autocomplete="off" autocapitalize="characters" spellcheck="false" placeholder="Ej. 8F3A71D2" />
        </label>
      )}
      <label class="grid gap-2 text-sm font-semibold text-emerald-950">
        Tu alias
        <input class="game-input" name="playerAlias" required minlength="2" maxlength="24"
          autocomplete="nickname" placeholder="Ej. Mauricio" />
      </label>
    </div>
    <button type="submit" class="game-btn mt-7 w-full">
      {isCreate ? 'Crear sala segura' : 'Entrar a la sala'}
    </button>
    <p data-form-status role="status" aria-live="polite" class="mt-4 text-center text-sm text-stone-600"></p>
  </form>
  <section data-recovery-panel hidden class="rounded-[2rem] border border-amber-950/10 bg-white p-6 shadow-xl sm:p-8">
    <h2 class="text-2xl font-black text-emerald-950">¡Sala creada!</h2>
    <p class="mt-3 text-sm text-stone-700">Guarda esta clave privada. Permite recuperar la sala si pierdes el acceso al teléfono y se muestra <strong>solo una vez</strong>.</p>
    <p class="mt-5 text-xs font-semibold uppercase tracking-widest text-stone-500">Clave de recuperación del anfitrión</p>
    <output data-recovery-value class="mt-2 block break-all rounded-xl bg-stone-100 p-4 font-mono text-sm text-emerald-950"></output>
    <div class="mt-5 grid gap-3 sm:grid-cols-2">
      <button type="button" data-copy-recovery class="game-btn-secondary">Copiar clave</button>
      <a data-enter-room class="game-btn text-center" href="/sala">Entrar a la sala</a>
    </div>
    <p role="status" aria-live="polite" data-copy-status class="mt-3 text-sm text-stone-600"></p>
  </section>
</div>
<style>
  .game-input { display:block; width:100%; min-height:3rem; border:2px solid #a8a29e; border-radius:.75rem; padding:.65rem .85rem; font-size:1rem; background:#fff; color:#1c1917; }
  .game-input:focus-visible { outline:3px solid #047857;outline-offset:2px; }
  .game-btn { display:block; min-height:3rem; padding:.8rem 1.1rem; border:0; border-radius:.8rem; background:#047857;color:#fff;font-weight:800;cursor:pointer; }
  .game-btn:hover { background:#065f46; }
  .game-btn:disabled { cursor:wait;opacity:.6; }
  .game-btn-secondary { min-height:3rem; padding:.8rem 1.1rem; border:2px solid #047857;border-radius:.8rem;background:white;color:#065f46;font-weight:800;cursor:pointer; }
</style>
<script>
  import { gameRpc, saveSession, type GameSession } from '../../scripts/gameApi';
  const form = document.querySelector<HTMLFormElement>('[data-room-form]');
  const status = document.querySelector<HTMLElement>('[data-form-status]');
  const panel = document.querySelector<HTMLElement>('[data-recovery-panel]');
  if (form && status && panel) {
    const params = new URLSearchParams(location.search);
    const code = params.get('codigo');
    const input = form.querySelector<HTMLInputElement>('[name="roomCode"]');
    if (input && code) input.value = code.toUpperCase();
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submit) submit.disabled = true;
      status.textContent = 'Conectando con la sala...';
      const data = new FormData(form);
      try {
        const create = form.dataset.mode === 'create';
        const alias = String(data.get('playerAlias') || '').trim();
        let session: GameSession;
        if (create) {
          session = await gameRpc<GameSession>('game_create_room', {
            p_alias: alias,
            p_room_name: String(data.get('roomName') || '').trim() || null,
            p_max_players: Number(data.get('maxPlayers')),
            p_dice_mode: String(data.get('diceMode')),
            p_initial_balance: 1500,
            p_go_bonus: 200,
            p_bail_amount: 50
          });
        } else {
          session = await gameRpc<GameSession>('game_join_room', {
            p_alias: alias,
            p_code: String(data.get('roomCode') || '').trim().toUpperCase()
          });
        }
        saveSession(session);
        const target = '/sala?codigo=' + encodeURIComponent(session.code);
        if (create && session.recovery) {
          form.hidden = true;
          panel.hidden = false;
          const value = panel.querySelector<HTMLElement>('[data-recovery-value]');
          const enter = panel.querySelector<HTMLAnchorElement>('[data-enter-room]');
          if (value) value.textContent = session.recovery;
          if (enter) enter.href = target;
          panel.querySelector<HTMLButtonElement>('[data-copy-recovery]')?.addEventListener('click', async () => {
            try {
              await navigator.clipboard.writeText(session.recovery || '');
              const message = panel.querySelector<HTMLElement>('[data-copy-status]');
              if (message) message.textContent = 'Clave copiada. Guárdala en un lugar privado.';
            } catch {
              const message = panel.querySelector<HTMLElement>('[data-copy-status]');
              if (message) message.textContent = 'Selecciona y copia la clave manualmente.';
            }
          });
        } else {
          window.location.assign(target);
        }
      } catch (error) {
        status.textContent = error instanceof Error ? error.message : 'No se pudo conectar.';
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

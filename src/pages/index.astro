---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoomAction from '../components/home/RoomAction.astro';
---

<BaseLayout
	title="Monopoly Perú | Banca para tu partida"
	description="Banca digital para acompañar tus partidas de Monopoly Perú en tablero físico."
>
	<div class="relative isolate min-h-dvh overflow-hidden bg-[#f7f0df]">
		<div
			class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-80 bg-[radial-gradient(circle_at_top,_#fcd34d_0,_transparent_58%)] opacity-55"
			aria-hidden="true"
		></div>
		<div
			class="pointer-events-none absolute -right-20 top-24 -z-10 size-72 rotate-12 rounded-[2.5rem] border-[14px] border-emerald-800/10 bg-emerald-600/5"
			aria-hidden="true"
		></div>

		<header class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 pt-6 sm:px-8 sm:pt-8">
			<a href="/" class="inline-flex items-center gap-2 rounded-lg text-emerald-950 focus-visible:outline-3 focus-visible:outline-offset-4 focus-visible:outline-emerald-700">
				<span class="grid size-9 place-items-center rounded-lg bg-emerald-700 text-sm font-black text-white shadow-[0_3px_0_#14532d]">M</span>
				<span class="font-bold tracking-tight">Monopoly Perú</span>
			</a>
			<span class="rounded-full border border-emerald-950/10 bg-white/65 px-3 py-1 text-xs font-semibold tracking-wide text-emerald-900">Banca digital</span>
		</header>

		<section class="mx-auto grid w-full max-w-6xl items-center gap-10 px-5 pb-10 pt-14 sm:px-8 sm:pb-16 sm:pt-20 lg:grid-cols-[1fr_0.9fr] lg:gap-20 lg:py-24">
			<div class="max-w-2xl">
				<p class="mb-4 inline-flex items-center gap-2 rounded-full bg-red-700 px-3 py-1.5 text-sm font-bold text-white shadow-[0_3px_0_#991b1b]">
					<span class="size-2 rounded-full bg-amber-300" aria-hidden="true"></span>
					Tu partida, tu tablero
				</p>
				<h1 class="max-w-xl font-serif text-[clamp(3rem,2rem+6vw,6rem)] font-black leading-[0.9] tracking-[-0.06em] text-emerald-950">
					Monopoly <span class="text-red-700">Perú</span>
				</h1>
				<p class="mt-6 max-w-xl text-lg leading-8 text-stone-700 sm:text-xl">
					Lleva la banca de tu juego de mesa al celular y deja que el tablero físico siga siendo el protagonista.
				</p>
				<ul class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-emerald-900">
					<li class="flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-600" aria-hidden="true"></span>Salas privadas</li>
					<li class="flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-600" aria-hidden="true"></span>Sin cuentas</li>
					<li class="flex items-center gap-2"><span class="size-2 rounded-full bg-emerald-600" aria-hidden="true"></span>Para jugar en persona</li>
				</ul>
			</div>

			<section class="rounded-[2rem] border border-amber-950/10 bg-white/80 p-5 shadow-[0_20px_50px_rgb(55_48_35_/_0.14)] backdrop-blur sm:p-7" aria-labelledby="room-actions-title">
				<div class="mb-5 flex items-center justify-between gap-4">
					<div>
						<p class="text-xs font-bold uppercase tracking-[0.18em] text-red-700">Primer paso</p>
						<h2 id="room-actions-title" class="mt-1 text-2xl font-black tracking-tight text-emerald-950">Prepara la mesa</h2>
					</div>
					<div class="grid size-12 grid-cols-2 gap-1 rounded-xl bg-amber-300 p-2 shadow-[0_3px_0_#b45309]" aria-hidden="true">
						<span class="rounded-full bg-amber-950"></span><span class="rounded-full bg-amber-950"></span><span class="rounded-full bg-amber-950"></span><span class="rounded-full bg-amber-950"></span>
					</div>
				</div>
				<div class="grid gap-4">
					<RoomAction href="/crear" label="Crear sala" description="Prepara una mesa privada para tu grupo." variant="primary">
						<svg slot="icon" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
					</RoomAction>
					<RoomAction href="/unirse" label="Unirse a sala" description="Ingresa con el código que te compartieron." variant="secondary">
						<svg slot="icon" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 17l5-5-5-5M4 12h10" /></svg>
					</RoomAction>
				</div>
				<p class="mt-5 text-center text-xs leading-5 text-stone-500">La creación y el acceso a salas se habilitarán en una próxima etapa.</p>
			</section>
		</section>

		<footer class="mx-auto flex w-full max-w-6xl items-center justify-between border-t border-amber-950/10 px-5 py-5 text-xs text-stone-500 sm:px-8">
			<span>Hecho para partidas alrededor del tablero.</span>
			<span class="font-semibold text-emerald-800">Perú</span>
		</footer>
	</div>
</BaseLayout>
